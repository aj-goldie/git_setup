#!/bin/bash
# ===========================================
# nbstripout-safe: Fault-tolerant notebook filter
# ===========================================
# Wraps nbstripout-fast with graceful JSON validation.
# If notebook JSON is malformed, passes through unchanged
# instead of crashing git operations.
#
# GLOBAL DEFAULTS: Applied when repo has no .git-nbconfig.yaml
#   - Strip outputs (default)
#   - Strip execution counts (default)
#   - Drop empty cells (--drop-empty-cells)
#
# Repos can override by adding their own .git-nbconfig.yaml
#
# Usage (git filter - reads from stdin, writes to stdout):
#   git config filter.jupyter.clean nbstripout-safe
#
# Works on: Linux, macOS, Windows (Git Bash)
# ===========================================

set -o pipefail

# Find Python executable (Windows uses 'python', Unix uses 'python3')
find_python() {
    if command -v python3 &>/dev/null; then
        echo "python3"
    elif command -v python &>/dev/null; then
        echo "python"
    else
        return 1
    fi
}

PYTHON_CMD=$(find_python)
if [[ -z "$PYTHON_CMD" ]]; then
    echo "[nbstripout-safe] Warning: Python not found, passing through unchanged" >&2
    cat
    exit 0
fi

# Create temp file for input
tmpfile=$(mktemp)
trap "rm -f '$tmpfile'" EXIT

# Read stdin to temp file
cat > "$tmpfile"

# Check if repo has its own config (let nbstripout-fast use it)
# Otherwise apply global defaults via CLI
EXTRA_ARGS=""
if ! git rev-parse --show-toplevel &>/dev/null || \
   [ ! -f "$(git rev-parse --show-toplevel 2>/dev/null)/.git-nbconfig.yaml" ]; then
    # No repo config - apply global defaults
    EXTRA_ARGS="--drop-empty-cells"
fi

# Validate JSON structure using Python (most portable)
if "$PYTHON_CMD" -c "import json; json.load(open(r'$tmpfile'))" 2>/dev/null; then
    # Valid JSON - run nbstripout-fast
    if nbstripout-fast -t $EXTRA_ARGS "$tmpfile" 2>/dev/null; then
        cat "$tmpfile"  # Output the stripped result to stdout
        exit 0
    else
        # nbstripout-fast failed for another reason - fallback to passthrough
        echo "[nbstripout-safe] Warning: nbstripout-fast failed, passing through unchanged" >&2
        cat "$tmpfile"
        exit 0
    fi
else
    # Invalid JSON - pass through unchanged with warning
    echo "[nbstripout-safe] Warning: Malformed notebook JSON detected, passing through unchanged" >&2
    cat "$tmpfile"
    exit 0
fi


